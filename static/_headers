/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'inline-speculation-rules' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()

# テンプレートから ?h=<ハッシュ> 付きで読み込むファイル。中身が変わると URL も変わる
/style.css
  Cache-Control: public, max-age=31536000, immutable
/theme.js
  Cache-Control: public, max-age=31536000, immutable
/theme-init.js
  Cache-Control: public, max-age=31536000, immutable

# Pagefind が出力する、ファイル名にハッシュを含むもの
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable

# フォントはファイル名を固定しているので、中身を差し替える時はファイル名も変える
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
